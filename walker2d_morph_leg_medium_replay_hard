#!/bin/bash

#SBATCH --job-name=vflow_walker_morph_leg_medium_replay_hard
#SBATCH --array=1-3
#SBATCH --output=/n/netscratch/tambe_lab/Everyone/FlowRL/slurm_logs/%x_%A_%a.out
#SBATCH --error=/n/netscratch/tambe_lab/Everyone/FlowRL/slurm_logs/%x_%A_%a.err
#SBATCH --time=14:00:00
#SBATCH --partition=seas_gpu
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --open-mode=append

# --- Base Directory ---
BASE_DIR="/n/netscratch/tambe_lab/Everyone/FlowRL"
SCRIPT_PATH="$(realpath $0)"  # Capture absolute path to this script
SUBMIT_DIR="$(pwd)"

# Create necessary directories
mkdir -p ${BASE_DIR}/slurm_logs
mkdir -p ${BASE_DIR}/training_output

# --- Define Output Directory ---
SEED_ID=${SLURM_ARRAY_TASK_ID}
OUTPUT_DIR="${BASE_DIR}/training_output/seed_${SEED_ID}"
mkdir -p ${OUTPUT_DIR}

echo "Output/Checkpoint Directory for Seed ${SEED_ID}: ${OUTPUT_DIR}"
echo ""

# --- Activate Conda ---
echo "Activating Conda environment..."
source ~/.bashrc
conda activate final_offdynamics

# --- Run Training Script ---
echo "Starting Python training script (train.py) for Seed ${SEED_ID}..."
python train.py \
    --policy vflow \
    --env walker2d-morph-leg \
    --mode 1 \
    --srctype medium-replay \
    --shift_level hard \
    --seed ${SEED_ID} \
    --n_samples 30 \
    --checkpoint_freq 5000 \
    --dynamics_gap_reward_scale 0.01 \
    --filter_percent 0.3 \
    --save-model \
    --dir ${OUTPUT_DIR}

echo "Slurm script for task ${SEED_ID} finished."